# Copy this file to .env and adjust values

# SQLite is the default (zero setup). To use PostgreSQL instead, uncomment and edit:
# DATABASE_URL=postgresql://user:password@localhost:5432/library_db
DATABASE_URL=sqlite:///./library.db

SECRET_KEY=change-this-to-a-random-secret-string

# Comma-separated: creates one initial staff account on first run if no users exist
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@library.local
ADMIN_PASSWORD=admin123
